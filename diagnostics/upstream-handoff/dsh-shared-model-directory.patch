+/** Only explicitly declared direct aliases with equivalent model/effort metadata
+ * can disappear from presentation. The real catalog and admission stay intact. */
+function presentationAliases(state: ModelDirectoryState): Map<string, string> {
+  const aliases = new Map<string, string>()
+  for (const alias of state.groups) {
+    const source = state.groups.find(g => g.id === alias.presentationAliasOf)
+    if (!source || source.id === alias.id || source.presentationAliasOf !== undefined || alias.models.length === 0) continue
+    const equivalent = (model: ModelProviderGroup['models'][number]) => {
+      const match = source.models.find(m => m.id === model.id)
+      if (!match) return false
+      const effortKey = (m: typeof model) => JSON.stringify([m.reasoning?.defaultEffort ?? null, (m.reasoning?.efforts ?? []).map(e => e.id).sort()])
+      return effortKey(model) === effortKey(match)
+    }
+    if (!alias.models.every(equivalent)) continue
+    if ([state.current, state.pending].some(s => s?.provider === alias.id && !alias.models.some(m => m.id === s.model))) continue
+    aliases.set(alias.id, source.id)
+  }
+  return aliases
+}
+
+function presentationState(state: ModelDirectoryState): ModelDirectoryState {
+  const aliases = presentationAliases(state)
+  if (aliases.size === 0) return state
+  const visible = (s: ModelSelection | null): ModelSelection | null => s && aliases.has(s.provider) ? { ...s, provider: aliases.get(s.provider)! } : s
+  return { ...state, groups: state.groups.filter(g => !aliases.has(g.id)), current: visible(state.current), pending: visible(state.pending) }
+}
+
+function rawSelection(state: ModelDirectoryState, selection: ModelSelection): ModelSelection {
+  const current = state.current
+  if (!current || presentationAliases(state).get(current.provider) !== selection.provider) return selection
+  const group = state.groups.find(g => g.id === current.provider)
+  if (!group?.models.some(m => m.id === selection.model)) return selection
+  return { ...selection, provider: current.provider }
+}
